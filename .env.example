# Copiar a .env y rellenar. NUNCA commitear .env
SPRING_PROFILES_ACTIVE=prod

DB_NAME=abogado
DB_USER=abogado
DB_PASSWORD=cambiar-en-produccion

# Minimo 32 caracteres (HS256). Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-chars

FIREBASE_PROJECT_ID=mi-abogado-prod
# El JSON de la service account va en ./secrets/firebase-service-account.json (montado read-only)

# Email del super-admin inicial: al primer arranque se crea el usuario y se vincula
# cuando esa persona entre con Google.
SUPER_ADMIN_EMAIL=admin@miabogado.co
